{
  "groups": [
    {
      "title": "Default Content",
      "id": "default",
      "components": [
        {
          "title": "Text",
          "id": "text",
          "plugins": {
            "da": {
              "name": "text",
              "type": "text"
            }
          }
        },
        {
          "title": "Image",
          "id": "image",
          "plugins": {
            "da": {
              "name": "image",
              "type": "img"
            }
          }
        }
      ]
    },
    {
      "title": "Sections",
      "id": "sections",
      "components": [
        {
          "title": "Section",
          "id": "section",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"section placeholder\" data-background-size=\"placeholder\" data-grid-layout=\"\"></div>"
            }
          }
        }
      ]
    },
    {
      "title": "Blocks",
      "id": "blocks",
      "components": [
        {
          "title": "Hero",
          "id": "hero",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"hero\"><div><div><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/jpeg\" srcset=\"\"><img loading=\"lazy\"></picture></div></div><div><div></div></div></div>"
            }
          }
        },
        {
          "title": "Cards",
          "id": "cards",
          "plugins": {
            "da": {
              "name": "cards",
              "rows": 1,
              "columns": 2
            }
          },
          "model": "cards",
          "filter": "cards"
        },
        {
          "title": "Card",
          "id": "card",
          "plugins": {
            "da": {
              "name": "card",
              "rows": 2,
              "columns": 0
            }
          },
          "model": "card"
        },
        {
          "title": "Teaser",
          "id": "teaser",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"teaser\" style=\"background: rgb(0, 0, 0); color: rgb(255, 255, 255);\"><div class=\"wrapper\"><div class=\"teaser-img-col\"><picture><source type=\"image/webp\" srcset=\"\"><source type=\"image/png\" srcset=\"\"><img loading=\"lazy\"></picture></div><div class=\"custom-ue-ttext\"></div></div></div>"
            }  
          }
        },
        {
          "title": "Carousel",
          "id": "carousel",
          "plugins": {
            "da": {
              "name": "carousel",
              "rows": 1,
              "columns": 1
            }
          },
          "model": "carousel",
          "filter": "carousel"
        },
        {
          "title": "Carousel Item",
          "id": "carousel-item",
          "plugins": {
            "da": {
              "name": "carousel-item",
              "rows": 1,
              "columns": 0
            }
          },
          "model": "carousel-item"
        }
      ]
    },
    {
      "title": "Commerce",
      "id": "commerce",
      "components": [
        {
          "title": "Product Teaser",
          "id": "product-teaser",
          "plugins": {
            "da": {
              "name": "product-teaser",
              "rows": 1,
              "columns": 1
            }
          },
          "model": "product-teaser"
        },
        {
          "title": "Product Details",
          "id": "product-details",
          "plugins": {
            "da": {
              "unsafeHTML": "<div class=\"product-details\" data-control=\"\"><div class=\"pdp-carousel-layout\"><div>carousel-layout</div><div></div></div><div class=\"pdp-control\"><div>control</div><div></div></div><div class=\"pdp-featured\"><div>featured</div><div></div></div><div class=\"pdp=sku\"><div>sku</div><div></div></div><div class=\"product-details__wrapper\"></div></div>"
            }
          }
        }
      ]
    }
  ]
}